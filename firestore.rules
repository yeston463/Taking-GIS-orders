rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Trusted Admin check:
    // Relies strictly on verified Firebase Auth UID custom claim `admin == true`
    // or existence of the user's verified UID in the server-managed `/admins/{uid}` collection.
    // Never trusts client-supplied email strings, unverified claims, hardcoded UIDs,
    // or client-editable fields.
    function isTrustedAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection:
    // - Strictly managed via Firebase Admin SDK on the backend or GCP Console.
    // - Clients CANNOT create, update, or delete admin records (prevents self-privilege escalation).
    // - An authenticated user may only read their own admin record; trusted admins may read all.
    match /admins/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (request.auth.uid == uid || isTrustedAdmin());
      allow list: if isTrustedAdmin();
      allow create, update, delete: if false;
    }

    // Orders collection:
    // - All order creation, customer lookup, and admin mutations MUST go through the backend API
    //   (which uses Firebase Admin SDK and enforces rate limiting, token hashing, and RBAC).
    // - Frontend clients (anonymous or authenticated) are strictly forbidden from directly
    //   creating, updating, deleting, or reading documents in `/orders`.
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // Server-managed rate limits and idempotency keys:
    // - Strictly inaccessible from any frontend client SDK.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    match /idempotencyKeys/{key} {
      allow read, write: if false;
    }

    // Durable query-token rotation records (which rotation key was consumed and
    // which rotation version it issued). Written only inside the same server
    // transaction that rotates the token; never readable or writable by a client.
    match /tokenRotations/{key} {
      allow read, write: if false;
    }
  }
}
