# ============================================================================
# GeoSpatial Studio — Minimal Environment Variables Template (.env.example)
# ============================================================================
# Architecture Summary:
# - Client (`src/config/firebase-client.ts`) and Server (`src/config/firebase-server.ts`)
#   share `VITE_FIREBASE_PROJECT_ID` and `VITE_FIREBASE_DATABASE_ID` so you NEVER
#   have to enter Project ID, Auth Domain, or Database ID twice.
# - Unused Firebase services (Storage, Cloud Messaging, Analytics) are removed.
# - `VITE_FIREBASE_AUTH_DOMAIN` is optional (automatically derived as `${VITE_FIREBASE_PROJECT_ID}.firebaseapp.com`).

# ============================================================================
# 1. SHARED & PUBLIC FIREBASE WEB APP CONFIG (Visible in Browser Build)
# ============================================================================
# SECURITY NOTICE:
# `VITE_FIREBASE_*` variables are compiled into frontend static assets for Google Sign-In
# on `/#admin`. They are public Firebase client identifiers, NOT non-disclosable server secrets.
# Restrict `VITE_FIREBASE_API_KEY` in Google Cloud Console -> APIs & Services -> Credentials:
#   - Application restrictions: HTTP referrers (your domain & localhost)
#   - API restrictions: ONLY `Identity Toolkit API` and `Token Service API`

# Shared Project ID & Named Firestore Database ID (used by both Client & Server Admin SDK):
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0041017161"
VITE_FIREBASE_DATABASE_ID="ai-studio-cb63a7bd-f74c-4c79-9ba8-1cb9e33b42e9"

# Public Web App Identifiers (from Firebase Console -> Project Settings -> General -> Your apps):
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_APP_ID=""

# Optional: Only set if using a custom Auth domain (defaults to `${VITE_FIREBASE_PROJECT_ID}.firebaseapp.com`)
# VITE_FIREBASE_AUTH_DOMAIN=""

# ============================================================================
# 2. SERVER-ONLY SECRETS & ACCESS CONTROL (Never Exposed to Browser)
# ============================================================================

# QUERY_TOKEN_PEPPER (Required Server Secret):
# HMAC-SHA256 secret pepper (min 16 chars, recommended 64 hex chars / 32 bytes) used to hash
# customer order lookup tokens (`queryTokenHash`).
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUERY_TOKEN_PEPPER=""

# ADMIN_UIDS (Required for Admin Dashboard Access):
# Comma-separated 28-character Firebase Auth UID(s) authorized as administrators (NOT email addresses).
# Obtain by signing in with Google on `/#admin` and copying the verified UID shown in the prompt,
# or from Firebase Console -> Authentication -> Users -> User UID.
ADMIN_UIDS=""

# ============================================================================
# 3. OPTIONAL SERVER & CLOUD RUN RUNTIME SETTINGS
# ============================================================================
# Server Firebase Admin SDK uses Google Cloud Application Default Credentials (ADC) by default.
# Do NOT embed service account JSON private keys in frontend code or Git.
# On Cloud Run, grant the runtime service account:
#   - roles/datastore.user
#   - roles/firebaseauth.viewer
#
# TRUST_PROXY: Optional reverse-proxy hop count ("0", "1"). Auto-detected as 1 on Cloud Run (`K_SERVICE`).
# TRUST_PROXY=""
