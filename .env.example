# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_UIDS: Comma-separated Firebase Authentication UIDs authorized as studio administrators.
# Format: 28-character Firebase Auth UID(s), e.g. "k8J9mN2pQ4rS6tU8vW0xY2zA4bC6" (NOT email addresses).
# How to obtain: Sign in with Google on /#admin; if not yet whitelisted, the UI will display your verified Firebase UID to copy here.
ADMIN_UIDS=""

# QUERY_TOKEN_PEPPER: Required server-side HMAC-SHA256 secret pepper (minimum 16 chars, recommended 64 hex chars / 32 bytes).
# Used to hash customer order lookup tokens (queryTokenHash). No default fallback is hardcoded.
# Generate locally via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUERY_TOKEN_PEPPER=""

# VITE_FIREBASE_API_KEY: Firebase Web API Key for admin Google Sign-In on /#admin.
# Kept in environment variables instead of firebase-applet-config.json to prevent GitHub Secret Scanning alerts.
VITE_FIREBASE_API_KEY=""

# --- Optional Deployment & Proxy Configuration (Not required in AI Studio Secrets) ---
# Firebase Admin SDK uses Google Cloud Application Default Credentials (ADC) by default.
# On Cloud Run (same GCP project gen-lang-client-0041017161), ADC works automatically without any private key file
# when the Cloud Run service account has minimal IAM roles: roles/datastore.user and roles/firebaseauth.viewer.
#
# TRUST_PROXY: Controls reverse-proxy X-Forwarded-For hop parsing (e.g. "0", "1", "true").
# Automatically enabled (1 hop) when K_SERVICE is detected on Cloud Run; defaults to 0 (disabled) for direct connections.
