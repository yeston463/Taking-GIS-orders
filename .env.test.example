# Isolated test environment template (never points at production Firestore)
NODE_ENV=test
IGNORE_LOCAL_FIREBASE_CONFIG_FILE=true
FIREBASE_PROJECT_ID=demo-geospatial-studio-test
VITE_FIREBASE_PROJECT_ID=demo-geospatial-studio-test
FIRESTORE_DATABASE_ID=ai-studio-isolated-test-db
VITE_FIREBASE_DATABASE_ID=ai-studio-isolated-test-db
FIREBASE_AUTH_DOMAIN=demo-geospatial-studio-test.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=demo-geospatial-studio-test.firebaseapp.com

# Tests generate their own random pepper; set one here only when running a
# manual isolated harness against the file-backed test repository.
QUERY_TOKEN_PEPPER=0123456789abcdef0123456789abcdef
